# Copia este archivo a ".env" y rellena los valores.
# El .env NO se sube a git (está en .gitignore).

# Token de HuggingFace (necesario para la diarización del Bloque B).
# Crear en: https://huggingface.co/settings/tokens
# Y aceptar las condiciones en: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# Solo si usas la API de OpenAI como fallback del LLM (Bloque C).
# OPENAI_API_KEY=
